# ==============================================================================
# JORMASS — OnlineFirst Proposal Hub & Academic Publishing Redesign
# Environment Variables & Configuration
# ==============================================================================

# 1. CORE DEMO CONFIGURATION (Required for Hub & Demo mode selection)
# Values for VITE_SITE_MODE: 'hub' (OnlineFirst Proposal Hub) | 'demo' (Direct Journal Demo) | 'admin' (CMS)
VITE_SITE_MODE=hub

# Default Theme Variant: 'demo1' (Heritage Academic) | 'demo2' (Contemporary Research) | 'demo3' (Editorial Digital Library)
VITE_THEME_VARIANT=demo1

# OnlineFirst Proposal Hub Canonical URL
VITE_HUB_URL=https://jormass-hub.previewnest.site

# Existing OJS Workflow Base URL (Preserves live editorial peer review & manuscript submissions)
VITE_OJS_BASE_URL=https://jormass.com/journal/index.php/jormass

# 2. PREVIEWNEST CUSTOM DEMO DOMAINS (Optional with automatic internal route fallbacks)
# If left empty, the Hub automatically falls back to internal routes: /demo/demo1, /demo/demo2, /demo/demo3
VITE_DEMO1_URL=https://jormass-demo1.previewnest.site
VITE_DEMO2_URL=https://jormass-demo2.previewnest.site
VITE_DEMO3_URL=https://jormass-demo3.previewnest.site

# 3. SUPABASE BACKEND (Strictly Optional during Demo & Concept Proposal Stage)
# When empty, JORMASS runs in full offline Local Demo Data Mode with bundled mock data.
# When provided in production phase, the app connects to live cloud database & storage.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 4. SERVER & PLATFORM VARIABLES
GEMINI_API_KEY=
APP_URL=
NOTIFICATION_EMAIL_RECIPIENT=onlinefirst2026@gmail.com
CONTRACT_EMAIL_RECIPIENT=editorial@jormass.com
RESEND_API_KEY=
